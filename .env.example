# Copy this file to `.env` and adjust the values:
#   Copy-Item .env.example .env
# `.env` is ignored by git, so your real secrets never get committed.

# ----- Shop (these are the defaults) -----
SHOP_TIMEZONE=Europe/Skopje
OPEN_DAYS=mon,tue,wed,thu,fri,sat
OPEN_TIME=09:00
CLOSE_TIME=18:00
SLOT_STEP_MINUTES=30
# Services as JSON (optional, defaults shown):
# SERVICES=[{"key":"haircut","name":"Haircut","duration_minutes":30},{"key":"beard_trim","name":"Beard trim","duration_minutes":20},{"key":"haircut_beard","name":"Haircut + Beard","duration_minutes":50}]
