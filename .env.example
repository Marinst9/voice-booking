# Copy this file to `.env` and adjust the values:
#   Copy-Item .env.example .env
# `.env` is ignored by git, so your real secrets never get committed.

# ----- Security (REQUIRED) -----
# Every request must send this in the X-API-Key header. At least 16 characters.
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# ----- Vapi -----
# The secret Vapi sends with every tool call to /vapi/tools. At least 16 characters.
# Put the SAME value in a "Bearer Token" credential in the Vapi dashboard (see README).
# Generate one the same way as API_KEY. Leave empty to disable the Vapi endpoint.
VAPI_SECRET=

# ----- Storage -----
# memory = fake calendar (lost on restart), postgres = real database.
# docker compose always uses postgres and builds DATABASE_URL itself.
CALENDAR_BACKEND=memory
# Used when running the app outside Docker with CALENDAR_BACKEND=postgres.
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 first and each connection waits ~5s.
DATABASE_URL=postgresql+psycopg://booking:booking@127.0.0.1:5432/booking

# ----- Docker Compose (optional, defaults shown) -----
# POSTGRES_USER=booking
# POSTGRES_PASSWORD=booking
# POSTGRES_DB=booking
# POSTGRES_PORT=5432
# API_PORT=8000

# ----- Shop (these are the defaults) -----
SHOP_TIMEZONE=Europe/Skopje
OPEN_DAYS=mon,tue,wed,thu,fri,sat
OPEN_TIME=09:00
CLOSE_TIME=18:00
SLOT_STEP_MINUTES=30
# Services as JSON (optional, defaults shown):
# SERVICES=[{"key":"haircut","name":"Haircut","duration_minutes":30},{"key":"beard_trim","name":"Beard trim","duration_minutes":20},{"key":"haircut_beard","name":"Haircut + Beard","duration_minutes":50}]

# ----- Logging -----
LOG_LEVEL=INFO
# json (one JSON object per line, for servers) or text (easier to read locally)
LOG_FORMAT=json
